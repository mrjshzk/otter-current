[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
shading/overrides/force_vertex_shading=true
shading/overrides/force_lambert_over_burley=true
anti_aliasing/screen_space_roughness_limiter/enabled=false

[shader_globals]

wind_intensity={
"type": "float",
"value": 0.5
}
wind_direction={
"type": "vec3",
"value": Vector3(0.5, 0, 1)
}
player_position={
"type": "vec3",
"value": Vector3(0, 0, 10)
}
diffuse_curve={
"type": "sampler2D",
"value": ""
}
specular_smoothness={
"type": "float",
"value": 0.05
}
fresnel_smoothness={
"type": "float",
"value": 0.05
}
outline_color={
"type": "color",
"value": Color(0, 0, 0, 1)
}
outline_width={
"type": "float",
"value": 4.0
}
